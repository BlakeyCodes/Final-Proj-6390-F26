% ePController.m
% Given current attitude and angular rate estimates, compute a commanded
% torque to achieve the desired attitude and angular rate
%% Inputs
% C_IB_des: [3x1 array]: current s/c position vector
% omg_B_est: [3x1 array]: current s/c velocity vector
% C_IB_des:  [scalar]   :
% C_IB_des_p [3x1 array]: 
% dt
% Kp
% Kd
%% outputs
%C_IB_des [3x3 array]: desired body to inertial attitude that satisfies
%C_IB_des\hat{b}_B = \hat{b}_{Earth}
%
% Blake Berge
% ECE 6390
% November 2026

function [tau_cmd, atError, omg_des_B] = ePController( ...
    C_IB_est, omg_B_est, C_IB_des, C_IB_des_p, dt, Kp, Kd)

    % Calculate desired angular velocity
    C_delta = C_IB_des*C_IB_des_p';
    omg_des_I = rotvecFromDCM(C_delta)/dt;

    % Express desired angular velocity in the current spacecraft body frame
    omg_des_B = C_IB_est'*omg_des_I;

    % Calculate attitude error
    C_err = C_IB_est'*C_IB_des;
    atError = rotvecFromDCM(C_err);

    % Angular velocity error
    omg_err = omg_B_est-omg_des_B;

    % PD attitude controller
    tau_cmd = Kp*atError-Kd*omg_err;

end

% DCM to rotation vector
function e = rotvecFromDCM(C)
    cosTheta = (trace(C)-1)/2;
    cosTheta = max(-1,min(1,cosTheta));
    theta = acos(cosTheta);

    if theta < 1e-8
        e = 0.5*[ ...
            C(3,2)-C(2,3);
            C(1,3)-C(3,1);
            C(2,1)-C(1,2)];

    elseif abs(pi-theta) < 1e-6
        % Near-180-degree rotation: use symmetric part to estimate axis
        [V,D] = eig((C+C')/2);
        [~,idx] = min(abs(diag(D)-1));
        axis = real(V(:,idx));
        axis = axis/norm(axis);

        e = theta*axis;

    else
        axis = (1/(2*sin(theta)))*[ ...
            C(3,2)-C(2,3);
            C(1,3)-C(3,1);
            C(2,1)-C(1,2)];

        e = theta*axis;
    end
end